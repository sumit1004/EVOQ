# ──────────────────────────────────────────────
# EVOQ — Environment Variables
# Copy to .env and fill in values before running
# ──────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=4000

# Database — MySQL 8.4 via Prisma
DATABASE_URL="mysql://root:password@localhost:3306/evoq_dev"

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Session
SESSION_COOKIE_NAME=evoq_session
SESSION_TTL_HOURS=72

# CSRF
CSRF_TOKEN_TTL_HOURS=24

# Email provider (set to "console" for dev stub, or provider name for production)
EMAIL_PROVIDER=console

# Argon2id parameters (defaults are safe, override only if needed)
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST=65536
# ARGON2_PARALLELISM=2

